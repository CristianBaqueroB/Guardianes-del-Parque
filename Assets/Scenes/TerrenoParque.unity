  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EcoMissionManager
  currentPurity: 25
  purityPerCorrectDeposit: 12
  purityPenaltyPerMistake: 6
  purityLerpSpeed: 3
  missions:
  - title: "Misi\xF3n 1: Iniciativa Valledupar Limpia"
    description: Clasifica correctamente 2 residuos en los Puntos Limpios.
    type: 0
    targetCategory: 0
    targetCount: 2
    currentProgress: 0
    bonusPoints: 40
    bonusTime: 12
    isCompleted: 0
    educationalFact: "\xA1Cada residuo cuenta! Clasificar desde la fuente reduce hasta un 80% la basura en vertederos."
  - title: "Misi\xF3n 2: Cero Pl\xE1sticos en el Parque"
    description: "Clasifica 2 residuos de Pl\xE1stico en la Caneca Azul."
    type: 1
    targetCategory: 0
    targetCount: 2
    currentProgress: 0
    bonusPoints: 50
    bonusTime: 15
    isCompleted: 0
    educationalFact: "Las bolsas y botellas pl\xE1sticas tardan cientos de a\xF1os en degradarse y da\xF1an la fauna."
  - title: "Misi\xF3n 3: Vidrio Seguro"
    description: Clasifica 1 residuo de Vidrio en la Caneca Amarilla.
    type: 1
    targetCategory: 2
    targetCount: 1
    currentProgress: 0
    bonusPoints: 50
    bonusTime: 15
    isCompleted: 0
    educationalFact: El vidrio es 100% reciclable infinitas veces sin perder calidad.
  - title: "Misi\xF3n 4: Guardi\xE1n Disciplinado"
    description: Consigue una racha de x3 aciertos sin equivocarte.
    type: 2
    targetCategory: 0
    targetCount: 3
    currentProgress: 0
    bonusPoints: 80
    bonusTime: 20
    isCompleted: 0
    educationalFact: "\xA1La disciplina ecol\xF3gica constante es la clave para mantener limpio Valledupar!"
  - title: "Misi\xF3n 5: Restauraci\xF3n de la Fuente y el Parque"
    description: Alcanza el 100% de Pureza Ambiental en el Parque de la Vida.
    type: 3
    targetCategory: 0
    targetCount: 100
    currentProgress: 0
    bonusPoints: 150
    bonusTime: 30
    isCompleted: 0
    educationalFact: "\xA1El Parque de la Vida de Valledupar est\xE1 radiante y protegido gracias a ti!"
  activeMissionIndex: 0
  audioSource: {fileID: 0}
  missionCompleteSfx: {fileID: 0}
